# Machine-specific settings for the deploy and sync scripts (scripts/load_local_config.sh).
# Copy this file to deploy.local.env (git-ignored) and fill it in. Never commit the real one.

# The server that runs the containers (a Tailscale name or IP works well).
BEELINK_HOST=your-server-address
BEELINK_USER=your-windows-username

# That user's home folder on the server, with forward slashes.
BEELINK_HOME=C:/Users/your-windows-username

# Only for sync_zwift_from_beelink.sh: where Zwift looks for workout files on this computer.
MAC_ZWIFT_DIR=$HOME/Documents/Zwift/Workouts/your-zwift-id
