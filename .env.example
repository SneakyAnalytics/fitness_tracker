# Example environment configuration file
# Copy this to .env and customize the paths for your system

# TrainingPeaks Credentials (Required for automated sync)
TRAININGPEAKS_USERNAME=your_email@example.com
TRAININGPEAKS_PASSWORD=your_password_here

# AI Coaching API Keys
# Gemini API - Free tier available, good for testing
GEMINI_API_KEY=your_gemini_api_key_here
# Claude API - Higher quality, costs ~$0.25-1.00 per weekly analysis
CLAUDE_API_KEY=your_claude_api_key_here

# Zwift workout output directory
ZWIFT_WORKOUTS_DIR=~/Documents/Zwift/Workouts/6870291

# Database path (relative to project root)
DB_PATH=data/fitness_data.db